# Copy to .env (never commit it). Fill in with: node bin/zoho-auth.js  (see docs/SETUP.md)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Data center of the Zoho account: us | eu | in | au | jp | ca | sa | uk | cn
ZOHO_DC=us
# Filled in by zoho-auth.js; leave empty to derive from ZOHO_DC
ZOHO_ACCOUNTS_SERVER=
ZOHO_API_DOMAIN=
# Zoho Books organisation id (zoho-auth.js lists yours)
ZOHO_ORG_ID=
